{
  "expo": {
    "name": "Monu",
    "slug": "monu-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "monumobile",
    "icon": "./assets/faviconpng.png",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "icon": "./assets/faviconpng.png",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/faviconpng.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.minhhung0403.monumobile"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "Cho phép Monu dùng microphone để tìm kiếm bằng giọng nói"
        }
      ],
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "c1e18bff-4a1e-48d8-904b-33ff3d76f89a"
      }
    }
  }
}
